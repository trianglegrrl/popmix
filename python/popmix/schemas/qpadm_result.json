{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://popmix.dev/schemas/qpadm_result.json",
  "title": "qpAdm Result",
  "description": "qpAdm admixture weight estimation result from popmix",
  "type": "object",
  "required": ["target", "sources", "weights", "chi_sq", "df", "p_value"],
  "properties": {
    "target": {
      "type": "string",
      "description": "Target population being modeled"
    },
    "sources": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Source populations"
    },
    "weights": {
      "type": "object",
      "description": "Admixture weights by source population",
      "additionalProperties": {"type": "number"}
    },
    "weights_detail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {"type": "string"},
          "weight": {"type": "number"},
          "std_err": {"type": "number"},
          "ci_lower": {"type": "number"},
          "ci_upper": {"type": "number"}
        },
        "required": ["source", "weight"]
      },
      "description": "Detailed weight information with standard errors"
    },
    "chi_sq": {
      "type": "number",
      "description": "Chi-squared statistic for model fit"
    },
    "df": {
      "type": "integer",
      "description": "Degrees of freedom"
    },
    "p_value": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "P-value for model fit"
    },
    "model_fit": {
      "type": "object",
      "properties": {
        "chi_sq": {"type": "number"},
        "df": {"type": "integer"},
        "p_value": {"type": "number"},
        "good_fit": {"type": "boolean"}
      },
      "description": "Model fit summary"
    },
    "feasible": {
      "type": "boolean",
      "description": "Whether all weights are in [0, 1]"
    }
  }
}
