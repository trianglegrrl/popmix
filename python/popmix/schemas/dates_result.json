{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://popmix.dev/schemas/dates_result.json",
  "title": "DATES Result",
  "description": "DATES admixture dating result from popmix",
  "type": "object",
  "required": ["test_pop", "source1", "source2", "generations", "years_bp"],
  "properties": {
    "test_pop": {
      "type": "string",
      "description": "Test (admixed) population"
    },
    "source1": {
      "type": "string",
      "description": "First source population"
    },
    "source2": {
      "type": "string",
      "description": "Second source population"
    },
    "generations": {
      "type": "number",
      "description": "Estimated generations since admixture"
    },
    "generations_se": {
      "type": "number",
      "description": "Standard error of generations estimate"
    },
    "years_bp": {
      "type": "number",
      "description": "Estimated years before present (at 29 years/generation)"
    },
    "years_bp_se": {
      "type": "number",
      "description": "Standard error of years BP estimate"
    },
    "amplitude": {
      "type": "number",
      "description": "Decay curve amplitude"
    },
    "r_squared": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "R-squared of exponential fit"
    },
    "n_snps": {
      "type": "integer",
      "description": "Number of SNPs used"
    },
    "timing": {
      "type": "object",
      "properties": {
        "generations": {"type": "number"},
        "generations_se": {"type": "number"},
        "years_bp": {"type": "number"},
        "years_bp_se": {"type": "number"}
      },
      "description": "Timing estimates summary"
    },
    "fit": {
      "type": "object",
      "properties": {
        "amplitude": {"type": "number"},
        "r_squared": {"type": "number"}
      },
      "description": "Fit quality summary"
    }
  }
}
