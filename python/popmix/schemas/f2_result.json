{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://popmix.dev/schemas/f2_result.json",
  "title": "F2 Result",
  "description": "F2 statistic result from popmix",
  "type": "object",
  "required": ["pop1", "pop2", "estimate", "std_err", "z_score"],
  "properties": {
    "pop1": {
      "type": "string",
      "description": "First population"
    },
    "pop2": {
      "type": "string",
      "description": "Second population"
    },
    "estimate": {
      "type": "number",
      "description": "F2 point estimate"
    },
    "std_err": {
      "type": "number",
      "description": "Standard error of the estimate"
    },
    "z_score": {
      "type": "number",
      "description": "Z-score (estimate / std_err)"
    },
    "n_snps": {
      "type": "integer",
      "description": "Number of SNPs used"
    },
    "ci_lower": {
      "type": "number",
      "description": "Lower bound of 95% confidence interval"
    },
    "ci_upper": {
      "type": "number",
      "description": "Upper bound of 95% confidence interval"
    },
    "confidence_interval": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2,
      "description": "95% confidence interval [lower, upper]"
    }
  }
}
