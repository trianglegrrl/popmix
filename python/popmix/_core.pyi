# --- data containers -----------------------------------------------------------

class Sample:
    id: str
    population: str
    ploidy: str
    def __init__(self, id: str, population: str, ploidy: str = "diploid") -> None: ...

class Snp:
    id: str
    chromosome: str
    position_bp: int
    position_cm: float
    allele_ref: str
    allele_alt: str
    def __init__(self, id: str, chromosome: str, position_bp: int, position_cm: float = 0.0,
                 allele_ref: str = "N", allele_alt: str = "N") -> None: ...

class GenotypeMatrix:
    n_samples: int
    n_snps: int
    samples: list[Sample]
    snps: list[Snp]
    populations: list[str]
    def __init__(self, data: NDArray[np.uint8], samples: Sequence[Sample],
                 snps: Sequence[Snp]) -> None: ...
    def to_numpy(self) -> NDArray[np.uint8]: ...
    def allele_frequencies(self, populations: Sequence[str] | None = None) -> AlleleFrequencies: ...

class AlleleFrequencies:
    n_snps: int
    n_populations: int
    populations: list[str]
    def to_numpy(self) -> NDArray[np.float64]: ...
    def counts_to_numpy(self) -> NDArray[np.uint32]: ...
    def get(self, snp_idx: int, pop_name: str) -> float | None: ...
    def filter_populations(self, populations: Sequence[str]) -> AlleleFrequencies: ...

class F2Blocks:
    n_populations: int
    n_blocks: int
    block_lengths: list[int]
    fst_block_lengths: list[int]
    provenance: dict[str, Any] | None
    populations: list[str]
    def subset(self, populations: Sequence[str]) -> F2Blocks: ...
    def counts_per_block(self, pop_a: str, pop_b: str) -> NDArray[np.float64] | None: ...
    @staticmethod
    def from_block_means(populations: Sequence[str], block_lengths: Sequence[int],
                         means: Sequence[Sequence[Sequence[float]]],
                         counts: Sequence[Sequence[Sequence[float]]]) -> F2Blocks: ...
    def select_blocks(self, blocks: Sequence[int]) -> F2Blocks: ...
    def fst_per_block(self, pop_a: str, pop_b: str) -> NDArray[np.float64] | None: ...
    def f2(self, pop_a: str, pop_b: str) -> dict[str, float | int] | None: ...
    def f3(self, pop_a: str, pop_b: str, pop_c: str) -> dict[str, float | int] | None: ...
    def f4(self, pop_a: str, pop_b: str, pop_c: str, pop_d: str) -> dict[str, float | int] | None: ...
    def fst(self, pop_a: str, pop_b: str) -> dict[str, float | int] | None: ...
    def f2_matrix(self) -> NDArray[np.float64]: ...
    def f2_per_block(self, pop_a: str, pop_b: str) -> NDArray[np.float64] | None: ...
    def save(self, path: str, source: str | None = None) -> None: ...

class AdmixGraph:
    node_count: int
    edge_count: int
    leaves: list[str]
    num_drift_edges: int
    def get_edge_weights(self) -> list[float]: ...
    def expected_f2(self, pop_a: str, pop_b: str) -> float: ...

