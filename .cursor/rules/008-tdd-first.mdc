### MultiQC Module

```python
def test_multiqc_finds_popmix_json(tmp_path):
    """MultiQC module should detect popmix output files."""
    test_file = tmp_path / "sample_popmix_stats.json"
    test_file.write_text('{"f2": {"A_B": 0.02}}')
    
    module = PopmixModule()
    found = module.find_log_files(str(tmp_path))
    assert len(found) == 1

def test_multiqc_parses_qpadm_results(tmp_path):
    """MultiQC should correctly parse qpAdm JSON."""
    test_file = tmp_path / "test_qpadm.json"
    test_file.write_text('{"target": "French", "weights": [0.45, 0.55]}')
    
    data = parse_qpadm_json(test_file)
    assert data["target"] == "French"
```

